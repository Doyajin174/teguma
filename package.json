{
  "name": "teguma",
  "version": "0.6.0",
  "description": "AI-native design bridge — Penpot MCP + brand context engine",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "teguma": "dist/index.js"
  },
  "files": [
    "dist",
    "assets/fonts",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Doyajin174/teguma.git"
  },
  "homepage": "https://github.com/Doyajin174/teguma",
  "bugs": {
    "url": "https://github.com/Doyajin174/teguma/issues"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "testbed:promo": "node experiments/company-promo-testbed/render.mjs",
    "testbed:promo:v2": "node experiments/company-promo-editorial-v2/render.mjs",
    "testbed:promo:v2:check": "npm run testbed:promo:v2 && git diff --exit-code -- experiments/company-promo-editorial-v2/output",
    "testbed:promo:v3": "node experiments/company-promo-naver-v3/render.mjs",
    "testbed:promo:v3:check": "npm run testbed:promo:v3 && git diff --exit-code -- experiments/company-promo-naver-v3/output",
    "stock:verify": "node scripts/verify-stock.mjs",
    "stock:verify:v2": "node scripts/verify-stock.mjs stock/generated/company-promo-v2/manifest.json",
    "stock:verify:v3": "node scripts/verify-stock.mjs stock/generated/company-promo-v3/manifest.json",
    "design:demo": "npm run build && node scripts/design-demo.mjs",
    "design:gallery": "npm run build && node scripts/design-gallery.mjs",
    "web:dev": "npm run build && node web/server.mjs",
    "lint": "eslint src/",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "penpot",
    "figma",
    "design",
    "ai"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@resvg/resvg-js": "^2.6.2",
    "pngjs": "^7.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/pngjs": "6.0.5",
    "eslint": "^10.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
